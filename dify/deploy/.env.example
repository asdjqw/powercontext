# ============================================================
# Dify 1.18 部署时需要追加到 dify/docker/.env 的配置（全部为占位值）
# 用法：把下面的键值追加到 Dify 源码 docker/.env，再 docker compose up -d
# ============================================================

# ---------- 1. 向量库：pgvector（可选，仅 Dify 自身使用） ----------
VECTOR_STORE=pgvector

# ---------- 2. 允许 HTTP 节点访问私网里的 PowerContext ----------
# 填 PowerContext 所在主机的 IP 或网段；如果 PowerContext 有公网地址可留空。
SSRF_PROXY_ALLOW_PRIVATE_IPS=<private-host-or-cidr>

# ---------- 3. 模型供应商（MiniMax，OpenAI 兼容） ----------
# 凭据不从这里生效，需要用 scripts/03_config_provider.sh 写入 Dify。
MINIMAX_API_KEY=<your-key>
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ---------- 4. PowerContext 地址 ----------
# 实际生效位置：应用 → 工作流 → 环境变量 → POWERCONTEXT_BASE_URL
POWERCONTEXT_BASE_URL=http://host.docker.internal:8099

# ---------- 5. 保持默认 ----------
FORCE_VERIFYING_SIGNATURE=true
PLUGIN_STORAGE_TYPE=local
MARKETPLACE_ENABLED=true
